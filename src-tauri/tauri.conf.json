{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Poxi ARK Launcher",
  "version": "1.0.0",
  "identifier": "com.poxi.ark.launcher",
  "build": {
    "frontendDist": "../src-web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node dev-server.js",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Poxi ARK Launcher",
        "width": 550,
        "height": 750,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
