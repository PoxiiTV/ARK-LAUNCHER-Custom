{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poxi ARK Optimizer",
  "version": "1.0.0",
  "identifier": "com.poxi.ark.optimizer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Poxi ARK Optimizer",
        "width": 960,
        "height": 680,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
